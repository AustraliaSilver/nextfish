# Files from build
**/*.o
**/*.s
src/.depend

# Built binary
src/stockfish*
src/-lstdc++.res
*.exe

# Neural network for the NNUE evaluation
**/*.nnue

# HARENN model files.
# The tracked model lives in src/ and must stay tracked; only the stray
# copies (e.g. the one next to a built binary) are ignored.
*.harenn
!src/nextfish.harenn
*.harenn-checkpoint
harenn_checkpoint*.pt

# Generated HARENN training data. It is produced by the datagen workflow and
# pushed to the "data" branch, see data/README.md.
/data/*.json
/data/*.jsonl

# Opening books and match output
*.pgn
!UHO_2022_8mvs_+110_+119.pgn
*.epd
*.zip

# Build and match output directories
builds/
matches/
temp/

# Files generated by the instrumented tests
tsan.supp
__pycache__/
tests/syzygy
tests/bench_tmp.epd
src/test_*.log
src/test_input.txt

# Engine test / match scratch files
nextfish_input.txt
nextfish_test.log
nextfish_err.log
nextfish_built.exe
stockfish.profdata

# SPSA tuning state
tuning_state.json
spsa_*.json
spsa_*.jsonl
